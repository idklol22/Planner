{
  "name": "todomate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A calendar-first task, notes, habit and calorie companion that hands finished notes to LearnHarness.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --base=./",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sb:deploy": "supabase db push --remote && supabase functions deploy hub --no-verify-jwt",
    "sb:new-device": "node scripts/supabase-new-device.mjs",
    "test:sb": "vitest run --config supabase/vitest.config.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@blocknote/core": "^0.57.0",
    "@blocknote/mantine": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
